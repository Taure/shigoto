{application, shigoto, [
    {description, "PostgreSQL-backed background job queue for Erlang, an Oban alternative"},
    {vsn, "git"},
    {registered, [shigoto_sup]},
    {mod, {shigoto_app, []}},
    {applications, [kernel, stdlib, crypto, minato, telemetry, seki]},
    {env, []},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/Taure/shigoto"}]}
]}.
